# Server runtime configuration
PORT=3000
NODE_ENV=development
DISABLE_HMR=false

# Optional persistent SQLite location. Defaults to ./data/breathewise.db.
# On a host with a mounted persistent disk, set this to a path inside that disk.
# Example only: BREATHEWISE_DB_PATH=/var/data/breathewise.db
BREATHEWISE_DB_PATH=

# Optional exact Vite dev/preview hostnames, comma-separated (no protocol or path).
# Localhost and IP addresses are allowed by Vite defaults.
# Example: VITE_ALLOWED_HOSTS=preview.example.com,.preview.example.com
VITE_ALLOWED_HOSTS=

# Optional external air-quality data provider API keys (server-side only; no secrets committed)
# CPCB / India Open Government Data Platform API key
DATA_GOV_IN_API_KEY=
# OpenAQ v3 API key
OPENAQ_API_KEY=
